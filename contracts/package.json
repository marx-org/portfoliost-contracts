{
  "name": "@marx-org/contracts",
  "version": "1.6.80",
  "type": "module",
  "description": "Portfoliost API contract — OpenAPI spec shared by frontend and backend",
  "main": "./openapi.yaml",
  "exports": {
    ".": "./openapi.yaml",
    "./openapi.yaml": "./openapi.yaml",
    "./fx": {
      "types": "./dist/fx.d.ts",
      "default": "./dist/fx.js"
    },
    "./currencies": {
      "types": "./dist/currencies.d.ts",
      "default": "./dist/currencies.js"
    }
  },
  "files": [
    "openapi.yaml",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "python3 scripts_check_spec.py"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Marx2/portfoliost-contracts.git"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
